<!DOCTYPE html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={Plug.CSRFProtection.get_csrf_token()} />
    <title>Bumblebee LNS</title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <style>
      :root { font-family: system-ui, sans-serif; color: #172033; background: #f5f7fb; }
      body { margin: 0; }
      .site-main { max-width: 72rem; margin: 0 auto; padding: 2rem 1.5rem 3rem; }
      body:has(#backpex-app-shell) > .site-main { max-width: none; padding: 0; }
      h1 { margin-bottom: .5rem; }
      nav { background: #172033; color: white; }
      nav .nav-inner { max-width: 72rem; margin: 0 auto; padding: .9rem 1.5rem; display: flex; gap: 1.25rem; align-items: center; }
      nav a { color: #dce5f5; text-decoration: none; }
      nav a.brand { color: white; font-weight: 700; margin-right: auto; }
      .status { display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: 1rem; margin-top: 2rem; }
      .card { padding: 1.25rem; border-radius: .75rem; background: white; box-shadow: 0 1px 4px #0001; }
      .ok { color: #087443; font-weight: 700; }
      code { font-size: .9em; }
      .page-header { display: flex; justify-content: space-between; align-items: end; gap: 1rem; margin-bottom: 1.5rem; }
      .page-header h1 { margin: 0; }
      .eyebrow { margin: 0 0 .3rem; color: #52627a; font-size: .78rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
      .muted { color: #66758a; }
      .table-card { padding: 0; overflow: hidden; }
      .table-wrap { overflow-x: auto; }
      table { width: 100%; border-collapse: collapse; }
      th, td { padding: .85rem 1rem; border-bottom: 1px solid #e4e9f1; text-align: left; vertical-align: middle; }
      th { color: #52627a; background: #f8faff; font-size: .8rem; text-transform: uppercase; letter-spacing: .04em; }
      tr:last-child td { border-bottom: 0; }
      .actions { text-align: right; }
      .button { display: inline-block; border: 1px solid #2563eb; border-radius: .45rem; padding: .55rem .85rem; background: #2563eb; color: white; font: inherit; font-weight: 600; text-decoration: none; cursor: pointer; }
      .button.secondary { border-color: #cbd5e1; background: white; color: #334155; }
      .form-card { max-width: 42rem; }
      .field { display: block; margin-bottom: 1.25rem; }
      .field > label, .field > legend { display: block; margin-bottom: .4rem; font-weight: 650; }
      .field input[type="text"], .field select { width: 100%; box-sizing: border-box; border: 1px solid #cbd5e1; border-radius: .45rem; padding: .65rem .75rem; background: white; font: inherit; }
      .field input:disabled { background: #eef2f7; color: #64748b; }
      fieldset.field { padding: 0; border: 0; }
      .check-row { display: flex; align-items: center; gap: .55rem; margin: .45rem 0; }
      .field-error { display: block; margin-top: .35rem; color: #b42318; }
      .form-actions { display: flex; gap: .7rem; margin-top: 1.5rem; }
      .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
      @media (max-width: 40rem) { .page-header { align-items: start; flex-direction: column; } }
    </style>
  </head>
  <body>
    <nav>
      <div class="nav-inner">
        <.link navigate={~p"/"} class="brand">Bumblebee LNS</.link>
        <.link navigate={~p"/areas"}>Areas</.link>
      </div>
    </nav>
    <main class="site-main"><.flash_group flash={@flash} />{@inner_content}</main>
  </body>
</html>
